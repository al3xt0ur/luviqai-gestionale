# luviqAI — esempio variabili per STAGING
# NON inserire segreti reali in questo file. Configurare i valori nel pannello Render.

NODE_ENV=production
APP_ORIGIN=https://staging.luviqai.it
PUBLIC_APP_URL=https://staging.luviqai.it

# Database STAGING separato da produzione (Supabase/progetto dedicato)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# In staging nessuna email reale
MAIL_MODE=preview
MAIL_FROM=staging@localhost.invalid
MAIL_FROM_NAME=luviqAI Staging

# Non usare credenziali SMTP/Resend operative nello staging
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# AI opzionale: usare una chiave separata/non produttiva se necessaria
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Disabilita bootstrap/backup locale nello staging
BOOTSTRAP_DEMO=0
